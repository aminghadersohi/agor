# Anthropic API Key for Claude Code integration
ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables explicit-consent profile image-to-3D generation via Meshy.
# MESHY_API_KEY=...

# Database path (optional, defaults to ~/.agor/agor.db)
# AGOR_DB_PATH=file:~/.agor/agor.db

# Server port (optional, defaults to 3030)
# PORT=3030
